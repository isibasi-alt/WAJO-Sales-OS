<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wajo.intel-crawl</string>

  <!-- install.sh が実際のパスに書き換える -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__INTEL_DIR__/mac/run-crawl.sh</string>
  </array>

  <!-- 2時間おき（7200秒）。前の巡回が終わっていなければ重ねて動かない -->
  <key>StartInterval</key>
  <integer>7200</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/wajo-intel-crawl.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/wajo-intel-crawl.err</string>
</dict>
</plist>
